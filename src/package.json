{
  "name": "simple-node-pm2-project",
  "version": "1.0.0",
  "description": "A simple Node.js Express app that can run with PM2.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop simple-node-api",
    "pm2:restart": "pm2 restart simple-node-api",
    "pm2:logs": "pm2 logs simple-node-api"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
